# Reference for the environment variables this project reads. Nothing loads a .env
# file automatically on this branch (there is no `langgraph dev` server here), so
# export these in your shell before running a driver -- or, from the repo root,
# `set -a; . ./.env; set +a`.

# The model id passed to the proxy. GET $ANTHROPIC_BASE_URL/v1/models at work lists the
# ids your account exposes (see BEDROCK_PROXY.md).
# Examples: eu.anthropic.claude-sonnet-5-5 (the default) | eu.anthropic.claude-haiku-5-5
#           eu.anthropic.claude-opus-5-5
DQ_AGENT_MODEL=eu.anthropic.claude-sonnet-5-5

# Prompt caching. On by default: the agent resends the whole transcript plus the tool
# schema every turn, and a cached prefix is billed at roughly a tenth of the input
# rate. Set to 0 if the proxy rejects `cache_control` (see BEDROCK_PROXY.md).
#DQ_AGENT_PROMPT_CACHE=1

# Postgres DSN, read by the connector when scoping a database table (profile_table) and
# no uri is passed explicitly. Only needed if you scope tables rather than files. Accepts
# a postgresql:// URI or a libpq DSN (host=... dbname=...). Never commit a real DSN.
#DATABASE_DSN__datasets_1=postgresql://user:pass@host:5432/dbname

# The bedrock-proxy's Anthropic Messages endpoint and token. Both are already set in the
# work tool environments, so a driver inherits them from your shell. Only set them here
# if your shell does not already have them, and never commit a real token.
#ANTHROPIC_BASE_URL=http://your-bedrock-proxy.internal:5000/anthropic
#ANTHROPIC_AUTH_TOKEN=your-proxy-token

# Recorded as approved_by when the approval response doesn't supply an identity
# (localhost demo fallback; defaults to the OS user if unset)
#DQ_AGENT_APPROVER=
