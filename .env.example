# Reference for the environment variables this project reads. Nothing loads a .env
# file automatically on feat/bedrock-proxy-adapter (there is no `langgraph dev` server
# here), so export these in your shell before running a driver -- or, from the repo
# root, `set -a; . ./.env; set +a`.

# Branch feat/bedrock-proxy-adapter. The Bedrock model id passed to the proxy. Run
# scripts/explore_bedrock.py (or bedrock.get_available_models()) at work to confirm the
# exact ids your account exposes.
# Examples: eu.anthropic.claude-sonnet-5 (the default) | eu.anthropic.claude-opus-5
#           eu.anthropic.claude-sonnet-4-6 | eu.anthropic.claude-haiku-4-5-20251001-v1:0
DQ_AGENT_MODEL=eu.anthropic.claude-sonnet-5

# Postgres DSN, read by the connector when scoping a database table (profile_table) and
# no uri is passed explicitly. Only needed if you scope tables rather than files. Accepts
# a postgresql:// URI or a libpq DSN (host=... dbname=...). Never commit a real DSN.
#DATABASE_DSN__datasets_1=postgresql://user:pass@host:5432/dbname

# BEDROCK_PROXY_URL / BEDROCK_TOKEN are read by dwutils.bedrock itself, not by this
# project, and are expected to already be set in the work environment
# (admin-provisioned), so a driver inherits them from your shell. Only set them here
# if your shell does not already have them, and never commit a real token.
#BEDROCK_PROXY_URL=https://your-bedrock-proxy.internal
#BEDROCK_TOKEN=your-proxy-token

# Recorded as approved_by when the approval response doesn't supply an identity
# (localhost demo fallback; defaults to the OS user if unset)
#DQ_AGENT_APPROVER=
